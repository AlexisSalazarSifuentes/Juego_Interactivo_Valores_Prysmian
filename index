<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Conecta con Nuestros Valores | Prysmian</title>
<style>
:root{--navy:#29283d;--blue:#00a0c6;--green:#67b766;--orange:#f58220;--pink:#d94f8b;--bg:#f4f7fa;--white:#fff;--muted:#657080}*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:radial-gradient(circle at 10% 5%,#dff8f3,transparent 25%),radial-gradient(circle at 95% 10%,#fff0dd,transparent 30%),var(--bg);color:var(--navy);min-height:100vh}.wrap{max-width:980px;margin:auto;padding:22px}.top{display:flex;justify-content:space-between;align-items:center;gap:20px}.logo{width:190px;max-width:44vw}.pill{background:white;padding:9px 14px;border-radius:999px;box-shadow:0 4px 18px #2332; font-weight:700}.card{background:#fff;border-radius:24px;box-shadow:0 18px 50px #2332;padding:32px;margin-top:20px;overflow:hidden}.hero{text-align:center}.hero h1{font-size:clamp(2rem,6vw,4rem);margin:10px 0;background:linear-gradient(90deg,var(--blue),var(--green),var(--orange));-webkit-background-clip:text;color:transparent}.hero p{font-size:1.12rem;line-height:1.55;color:var(--muted);max-width:720px;margin:10px auto}.values{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:22px 0}.value{padding:16px 8px;border-radius:16px;color:white;font-weight:800}.v0{background:var(--orange)}.v1{background:var(--pink)}.v2{background:var(--green)}.v3{background:var(--blue)}button{border:0;border-radius:14px;padding:14px 22px;font-size:1rem;font-weight:800;cursor:pointer}.primary{color:white;background:linear-gradient(90deg,var(--blue),#087dae);box-shadow:0 8px 22px #00a0c655}.secondary{background:#eaf0f4;color:var(--navy)}.hidden{display:none}.hud{display:flex;justify-content:space-between;gap:12px;align-items:center}.progress{height:12px;background:#e7edf1;border-radius:20px;overflow:hidden;margin:18px 0}.bar{height:100%;background:linear-gradient(90deg,var(--blue),var(--green),var(--orange));transition:.4s}.scenario{font-size:clamp(1.25rem,3vw,1.75rem);line-height:1.35;margin:24px 0}.answers{display:grid;grid-template-columns:1fr 1fr;gap:12px}.answer{text-align:left;background:white;border:2px solid #dce5ea;color:var(--navy);transition:.15s}.answer:hover{transform:translateY(-2px);border-color:var(--blue);box-shadow:0 7px 15px #1232}.answer.correct{background:#e8f8e9;border-color:var(--green)}.answer.wrong{background:#fff0e8;border-color:var(--orange)}.feedback{border-radius:16px;padding:16px;margin-top:16px;line-height:1.45;background:#f0f5f7}.feedback strong{font-size:1.1rem}.nextline{display:flex;justify-content:flex-end;margin-top:15px}.scorebig{font-size:4rem;font-weight:900;color:var(--blue);margin:10px}.badge{display:inline-block;padding:9px 15px;background:#ecf9f7;border:2px solid var(--green);border-radius:999px;font-weight:800}.legend{text-align:left;display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:24px 0}.legend div{background:#f4f7f9;border-radius:14px;padding:13px}.footer{text-align:center;color:var(--muted);font-size:.85rem;margin:20px}.confetti{position:fixed;top:-10px;width:10px;height:15px;animation:fall 2.8s linear forwards}@keyframes fall{to{transform:translateY(105vh) rotate(700deg)}}@media(max-width:650px){.values,.answers,.legend{grid-template-columns:1fr 1fr}.card{padding:20px}.hud{font-size:.88rem}}
</style></head><body><div class="wrap"><div class="top"><img class="logo" src="data:image/png;base64," alt="Prysmian"><div class="pill">Living Our Values</div></div>
<section id="home" class="card hero"><div>⚡ RETO INTERACTIVO</div><h1>Conecta con nuestros valores</h1><p>Lee situaciones reales del trabajo diario y decide qué valor representa mejor cada actitud. Aprenderás mientras acumulas <b>puntos de energía</b>.</p><div class="values"><div class="value v0">💡 Innovación</div><div class="value v1">🔥 Passion</div><div class="value v2">🤝 Pertenencia</div><div class="value v3">🔗 Teamplay</div></div><label>Tu nombre o equipo<br><input id="player" maxlength="35" placeholder="Ej. Equipo Producción" style="margin:10px;padding:13px;width:min(360px,90%);border:2px solid #dce5ea;border-radius:12px;font-size:1rem"></label><br><button class="primary" onclick="start()">Comenzar reto</button></section>
<section id="game" class="card hidden"><div class="hud"><b id="who"></b><span id="count"></span><span>⚡ <b id="score">0</b></span></div><div class="progress"><div class="bar" id="bar"></div></div><div id="scenario" class="scenario"></div><div id="answers" class="answers"></div><div id="feedback" class="feedback hidden"></div><div class="nextline"><button id="next" class="primary hidden" onclick="next()">Siguiente →</button></div></section>
<section id="result" class="card hero hidden"><div style="font-size:3rem">🏆</div><h2 id="resultTitle">¡Reto completado!</h2><div class="scorebig" id="finalScore"></div><div class="badge" id="level"></div><p id="resultText"></p><div class="legend"><div><b>💡 Innovación</b><br>Explorar ideas, mejorar procesos y convertir aprendizajes en soluciones.</div><div><b>🔥 Passion</b><br>Entregar resultados con energía, compromiso, iniciativa y responsabilidad.</div><div><b>🤝 Pertenencia</b><br>Crear un entorno donde cada persona sea escuchada, respetada e incluida.</div><div><b>🔗 Teamplay</b><br>Colaborar con confianza, compartir conocimiento y alcanzar resultados comunes.</div></div><button class="primary" onclick="restart()">Jugar de nuevo</button> <button class="secondary" onclick="copyResult()">Copiar resultado</button></section><div class="footer">Prysmian Piedras Negras · Aprende, participa y vive nuestros valores</div></div>
<script>
const V=['Innovación','Passion','Pertenencia','Teamplay'];
const info={Innovación:'Innovar es cuestionar lo habitual, aprender y convertir ideas en mejoras útiles.',Passion:'Passion se demuestra al asumir responsabilidad, actuar con energía y cuidar la calidad del resultado.',Pertenencia:'Pertenencia significa crear un espacio respetuoso e inclusivo donde todas las voces cuentan.',Teamplay:'Teamplay es colaborar con confianza, compartir información y priorizar el resultado del equipo.'};
const Q=[
['Una persona detecta desperdicio de material, analiza la causa y propone una prueba piloto para reducirlo.','Innovación'],
['Ante una entrega crítica, una persona toma iniciativa, da seguimiento y mantiene el compromiso hasta cumplir con calidad.','Passion'],
['Durante una reunión, alguien invita a participar a una persona nueva y se asegura de que su idea sea escuchada.','Pertenencia'],
['Dos departamentos comparten información y coordinan prioridades para resolver juntos un retraso.','Teamplay'],
['Después de un error, el equipo documenta el aprendizaje y rediseña el método para evitar recurrencias.','Innovación'],
['Una persona enfrenta un reto difícil con actitud positiva, sentido de urgencia y enfoque en el resultado.','Passion'],
['Un líder comunica cambios a todos los turnos y verifica que nadie quede fuera de la información.','Pertenencia'],
['Una persona enseña a un compañero una práctica útil sin reservarse el conocimiento.','Teamplay'],
['El equipo digitaliza un formato repetitivo para ahorrar tiempo, papel y errores de captura.','Innovación'],
['Una persona cumple lo prometido, se responsabiliza por el impacto y busca superar la expectativa del cliente.','Passion'],
['Se reconocen distintas experiencias y perspectivas antes de tomar una decisión que afecta al área.','Pertenencia'],
['Mantenimiento, Producción y Calidad acuerdan un solo plan de acción y se apoyan durante la ejecución.','Teamplay'],
['Alguien pregunta “¿cómo podríamos hacerlo mejor?” y prueba una solución segura basada en datos.','Innovación'],
['Una persona persevera ante obstáculos y contagia energía para alcanzar una meta exigente.','Passion'],
['El equipo celebra las contribuciones de cada integrante y trata a todas las personas con respeto.','Pertenencia'],
['Una persona pide ayuda a tiempo, escucha otras opiniones y comparte el mérito por el resultado.','Teamplay']];
let qs=[],i=0,points=0,locked=false,name='';
function shuffle(a){return [...a].sort(()=>Math.random()-.5)}
function start(){name=document.getElementById('player').value.trim()||'Participante Prysmian';qs=shuffle(Q).slice(0,12);i=0;points=0;document.getElementById('home').classList.add('hidden');document.getElementById('game').classList.remove('hidden');document.getElementById('who').textContent=name;render()}
function render(){locked=false;document.getElementById('feedback').classList.add('hidden');document.getElementById('next').classList.add('hidden');document.getElementById('scenario').textContent=qs[i][0];document.getElementById('count').textContent=`Situación ${i+1} de ${qs.length}`;document.getElementById('score').textContent=points;document.getElementById('bar').style.width=((i)/qs.length*100)+'%';let opts=shuffle(V);document.getElementById('answers').innerHTML=opts.map(v=>`<button class="answer" onclick="pick(this,'${v}')">${icon(v)} ${v}</button>`).join('')}
function icon(v){return {Innovación:'💡',Passion:'🔥',Pertenencia:'🤝',Teamplay:'🔗'}[v]}
function pick(btn,v){if(locked)return;locked=true;let correct=qs[i][1],ok=v===correct;if(ok)points+=100;document.querySelectorAll('.answer').forEach(b=>{let val=b.textContent.trim().replace(/^\S+\s/,'');b.disabled=true;if(val===correct)b.classList.add('correct')});if(!ok)btn.classList.add('wrong');let f=document.getElementById('feedback');f.classList.remove('hidden');f.innerHTML=`<strong>${ok?'✅ ¡Correcto! +100 puntos':'💡 La mejor respuesta es '+correct}</strong><br>${info[correct]}`;document.getElementById('score').textContent=points;document.getElementById('next').classList.remove('hidden')}
function next(){i++;if(i<qs.length)render();else finish()}
function finish(){document.getElementById('game').classList.add('hidden');document.getElementById('result').classList.remove('hidden');document.getElementById('bar').style.width='100%';let pct=points/(qs.length*100),lvl=pct>=.9?'Embajador/a de los valores':pct>=.7?'Conector/a de valores':'Explorador/a de valores';document.getElementById('finalScore').textContent=points+' ⚡';document.getElementById('level').textContent=lvl;document.getElementById('resultTitle').textContent=`¡Muy bien, ${name}!`;document.getElementById('resultText').textContent=`Identificaste ${points/100} de ${qs.length} situaciones. Cada decisión cotidiana es una oportunidad para vivir los valores Prysmian.`;confetti()}
function restart(){document.getElementById('result').classList.add('hidden');document.getElementById('home').classList.remove('hidden')}
function copyResult(){let t=`Completé el reto “Conecta con nuestros valores” de Prysmian con ${points} puntos de energía.`;navigator.clipboard?.writeText(t);alert('Resultado copiado')}
function confetti(){for(let j=0;j<70;j++){let c=document.createElement('i');c.className='confetti';c.style.left=Math.random()*100+'vw';c.style.background=['#00a0c6','#67b766','#f58220','#d94f8b'][j%4];c.style.animationDelay=Math.random()+'s';document.body.appendChild(c);setTimeout(()=>c.remove(),4000)}}
</script></body></html>
